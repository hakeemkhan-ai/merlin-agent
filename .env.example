# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MERLIN_OWNER_TOKEN=
MERLIN_DATABASE_URL=postgresql+psycopg://merlin:CHANGE_ME@postgres:5432/merlin
POSTGRES_PASSWORD=CHANGE_ME
MERLIN_ARTIFACT_DIR=/data/artifacts
MERLIN_GEMINI_API_KEY=
MERLIN_GEMINI_MODEL=gemini-3.8-flash
# Operator-supplied estimates; verify rates for the chosen model before using budgets.
MERLIN_INPUT_COST_PER_MILLION=1
MERLIN_OUTPUT_COST_PER_MILLION=10
MERLIN_MAX_OUTPUT_TOKENS=8192
MERLIN_MAX_INPUT_TOKENS=65536
# Bounds include all provider retries. A truncated reply never dispatches tools.
MERLIN_MODEL_FIRST_CHUNK_TIMEOUT_SECONDS=60
MERLIN_MODEL_IDLE_TIMEOUT_SECONDS=60
MERLIN_MODEL_TOTAL_TIMEOUT_SECONDS=300
MERLIN_MODEL_STREAM_FLUSH_SECONDS=0.15
MERLIN_MODEL_TOKEN_CACHE_SIZE=64
# Optional discounted cached-input estimate; empty uses the normal input rate.
MERLIN_CACHED_INPUT_COST_PER_MILLION=
MERLIN_WORKSPACE_SETUP_TIMEOUT_SECONDS=180
MERLIN_CHECKPOINT_TIMEOUT_SECONDS=120
MERLIN_CLEANUP_TIMEOUT_SECONDS=15
MERLIN_TOOL_TIMEOUT_SECONDS=660
MERLIN_PARALLEL_READ_TOOLS=4
MERLIN_CONTEXT_CACHE_ENTRIES=128
MERLIN_INSTRUCTION_TTL_SECONDS=30
MERLIN_MAX_REQUEST_BYTES=1048576
MERLIN_MAX_EVENT_STREAMS=32
MERLIN_MAX_QUEUED_TASKS=100
MERLIN_READINESS_WORKER_MAX_AGE_SECONDS=30
MERLIN_E2B_API_KEY=
MERLIN_E2B_TEMPLATE=merlin
MERLIN_GITHUB_APP_ID=
MERLIN_GITHUB_INSTALLATION_ID=
MERLIN_GITHUB_PRIVATE_KEY_FILE=/run/secrets/github.pem
MERLIN_GITHUB_CLIENT_ID=
MERLIN_GITHUB_CLIENT_SECRET=
MERLIN_GITHUB_CALLBACK_URL=https://merlin.example.com/v1/github/callback
MERLIN_OTLP_ENDPOINT=http://otel:4318/v1/traces
MERLIN_ARTIFACT_RETENTION_DAYS=30
MERLIN_HOSTNAME=merlin.example.com
GITHUB_PRIVATE_KEY_PATH=../secrets/github.pem
